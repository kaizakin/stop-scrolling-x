{
  "manifest_version": 3,
  "name": "Stop Scrolling",
  "description": "Set a timer and block x.com until it ends.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "*://x.com/*",
    "*://www.x.com/*",
    "*://instagram.com/*",
    "*://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stop Scrolling",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  }
}
