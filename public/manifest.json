{
  "manifest_version": 3,
  "name": "Stop Scrolling",
  "description": "Set a timer and block x.com until it ends.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["*://x.com/*", "*://www.x.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Stop Scrolling",
    "default_popup": "index.html"
  }
}
